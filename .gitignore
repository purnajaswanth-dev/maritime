# ==============================================================================
# Master .gitignore for "Where Is My Ferry?"
# Covers: Python (ml-platform), Java Spring Boot (backend), React Vite (frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments (ml-platform)
# ------------------------------------------------------------------------------
.venv/
ml-platform/.venv/
venv/
ENV/
env/
**/__pycache__/
**/*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 2. Node.js, Vite & React (frontend)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
**/dist/
.vite/
**/.vite/
*.tsbuildinfo
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Java & Maven (backend)
# ------------------------------------------------------------------------------
backend/target/
**/target/
*.class
*.jar
*.war
*.ear
backend/.mvn/timing.properties
backend/bin/

# ------------------------------------------------------------------------------
# 4. Large Raw Datasets, Downloads & Streaming Traces
# ------------------------------------------------------------------------------
# Huge downloaded archives (> 100MB, e.g. raw CMEMS NetCDF and AIS archives)
ml-platform/data/downloads/
ml-platform/data/raw/
ml-platform/data/temp/
*.zip
*.tar.gz
*.nc

# Runtime streaming diagnostic trace append logs (can accumulate hundreds of MBs)
*.jsonl
ml-platform/data/manifests/*.jsonl

# Processed / Interim data rules:
# Keep essential verified ground truth & timetable data required by tests
ml-platform/data/processed/*
!ml-platform/data/processed/verified_voyages.parquet
ml-platform/data/interim/*
!ml-platform/data/interim/*.parquet

# Model rules:
# Keep frozen verified model artifact required by tests and integrity check
ml-platform/models/*
!ml-platform/models/vectorized_ridge_model.json
checkpoints/

# ------------------------------------------------------------------------------
# 5. Databases, Docker & Local Runtime Storage
# ------------------------------------------------------------------------------
postgres_data/
**/postgres_data/
*.sqlite
*.sqlite3
*.db-journal

# ------------------------------------------------------------------------------
# 6. Environment Variables, Secrets & Local Overrides
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local

# ------------------------------------------------------------------------------
# 7. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# JetBrains
.idea/
*.iml
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.classpath
.project
.settings/
