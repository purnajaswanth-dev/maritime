# =============================================================================
# Where Is My Ferry? - Production Docker Environment Configuration
# Copy this file to .env before starting docker-compose:
#   cp .env.example .env
# =============================================================================

# ---- PostgreSQL Database Configuration ----
POSTGRES_DB=where_is_my_ferry
POSTGRES_USER=ferry_user
POSTGRES_PASSWORD=ferry_secret_password_change_in_prod
POSTGRES_PORT=5432

# ---- Spring Boot Backend Configuration ----
SPRING_PROFILES_ACTIVE=prod
APP_JWT_SECRET=whereismyferrysupersecretkeyforjwttokengenerationshouldbeatleast256bitslong!
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Initial Admin User Seed (created if no admin exists on first launch)
APP_ADMIN_SEED_EMAIL=admin@example.com
APP_ADMIN_SEED_PASSWORD=Admin@PennArBed2026

# ---- Frontend & Ingress Ports ----
# Port on which the Nginx frontend proxy will be reachable
PORT=80
FRONTEND_PORT=80

# ---- Optional: Map Providers ----
# Free CARTO Voyager key (leave empty to use OpenStreetMap by default with zero key)
VITE_CARTO_KEY=
